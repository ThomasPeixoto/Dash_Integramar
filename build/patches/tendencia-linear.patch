+/**
+ * As inclinações ajustadas, em palavras.
+ *
+ * A reta sozinha convida a ler tendência onde há ruído, então cada série
+ * ganha o número E o veredito: inclinação por década, e se ela se distingue
+ * de zero ao nível de 95% com os graus de liberdade que a série tem de fato.
+ * Série curta demais não recebe reta nenhuma, e isso também é dito.
+ */
+function txTendenciasHTML(rows, ordem, rotuloSerie, unidade) {
+  const pt = getLang() === 'pt';
+  const fits = tendenciaLinear(rows, { ordem });
+  const ajustadas = ordem.filter((g) => fits.get(g)?.ajustou);
+  const curtas = ordem.filter((g) => fits.get(g) && !fits.get(g).ajustou);
+  if (!ajustadas.length && !curtas.length) return null;
+
+  const frases = ajustadas.map((g) => {
+    const f = fits.get(g);
+    // Por década só quando a série cobre uma: projetar uma década a partir de
+    // cinco anos diria mais do que foi medido.
+    const porDecada = f.span >= 10;
+    const taxa = f.b * (porDecada ? 10 : 1);
+    const sinal = taxa > 0 ? '+' : '\u2212';
+    const unid = `${unidade} ${t(porDecada ? 'tx_por_decada' : 'tx_por_ano')}`;
+    const num = `${sinal}${fmt(Math.abs(taxa), 2)}${unid}`;
+    return f.significativo
+      ? `<strong>${rotuloSerie(g)}</strong> ${num}`
+      : `<strong>${rotuloSerie(g)}</strong> ${num} ${pt ? '(não se distingue de zero)' : '(not distinguishable from zero)'}`;
+  });
+
+  const partes = [];
+  if (frases.length) {
+    partes.push(pt
+      ? `Retas ajustadas por mínimos quadrados sobre as medianas anuais, cada ano pesado pelo número de sítios: ${frases.join('; ')}.`
+      : `Lines fitted by least squares on the annual medians, each year weighted by its number of sites: ${frases.join('; ')}.`);
+  }
+  if (curtas.length) {
+    partes.push(pt
+      ? `Sem reta, por terem menos de ${TREND_MIN_ANOS} anos com dado: ${curtas.map(rotuloSerie).join(', ')}.`
+      : `No line, having fewer than ${TREND_MIN_ANOS} years with data: ${curtas.map(rotuloSerie).join(', ')}.`);
+  }
+  // O ajuste e sobre as medianas de cada ano, nao sobre os sitio-ano crus: o
+  // mesmo sitio reaparece todo ano, e trata-los como independentes estreitaria
+  // o intervalo da inclinacao sem que mais nada fosse medido.
+  partes.push(pt
+    ? 'O ano é a unidade do ajuste, não o sítio-ano — o mesmo sítio reaparece a cada ano e contá-lo como observação independente estreitaria o intervalo da inclinação sem medir nada a mais.'
+    : 'The year is the unit of the fit, not the site-year — the same site recurs every year, and counting it as an independent observation would narrow the slope interval without measuring anything more.');
+
+  return `<span class="nota">${partes.join(' ')}</span>`;
