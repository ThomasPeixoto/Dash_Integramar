+/**
+ * Retas ajustadas, uma por grupo, na cor do grupo e tracejadas.
+ *
+ * Ficam FORA da legenda (`legendHoverLink: false` e nome com prefixo) para
+ * que a legenda continue sendo a lista de taxons, e so vao do primeiro ao
+ * ultimo ano OBSERVADO de cada grupo -- estende-las pelo eixo inteiro seria
+ * extrapolar para anos em que aquele grupo nao foi amostrado.
+ */
+function retasDe(rows, { ordem, rotulo, cores, years }) {
+  const fits = tendenciaLinear(rows, { ordem });
+  return ordem.flatMap((g, i) => {
+    const f = fits.get(g);
+    if (!f?.ajustou) return [];
+    const cor = cores?.[i] ?? CAT[i % CAT.length];
+    return [{
+      name: `${rotulo.serie(g)} \u2014 tend.`,
+      type: 'line',
+      symbol: 'none',
+      silent: true,
+      legendHoverLink: false,
+      z: 1,
+      // Tracejada e mais fina que a serie: a reta e leitura, o dado e o
+      // que foi medido, e a hierarquia visual tem de dizer qual e qual.
+      lineStyle: { width: 1.6, color: cor, type: 'dashed', opacity: 0.85 },
+      tooltip: { show: false },
+      data: years.map((y) => (y >= f.x0 && y <= f.x1 ? f.a + f.b * y : '-')),
+    }];
+  });
