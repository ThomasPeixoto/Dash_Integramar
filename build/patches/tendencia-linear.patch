+/** Minimo de anos para ajustar: com 3 pontos sobra 1 grau de liberdade. */
+export const TREND_MIN_ANOS = 4;
+
+/**
+ * Minimos quadrados ponderados de `valor ~ ano`, por grupo.
+ *
+ * O ajuste e feito sobre as MEDIANAS ANUAIS -- os mesmos pontos que a linha
+ * desenha -- e nao sobre os sitio-ano crus. Ajustar nos crus daria mais
+ * pontos, mas o mesmo sitio reaparece todo ano: seriam pseudo-replicas, e a
+ * reta pareceria muito mais certa do que e.
+ *
+ * O peso de cada ano e o numero de sitios que entraram na mediana daquele
+ * ano. Sem isso um ano com 2 sitios puxa a reta tanto quanto um com 40 --
+ * e nesta serie isso nao e hipotese: o Rio e a unica regiao presente de 2001
+ * a 2005 e responde por 44% dos censos.
+ *
+ * Os pesos sao reescalados para somar o NUMERO DE ANOS antes do erro padrao.
+ * O que se repete no tempo e o ano, nao o sitio; tratar cada sitio como
+ * observacao independente encolheria o erro padrao artificialmente.
+ */
+export function tendenciaLinear(rows, { ordem } = {}) {
+  const agg = aggregate(rows, { stat: 'median' });
+  const peso = new Map();
+  for (const [key, g] of groupBy(rows, (r) => `${r.Year}|${r.group}`)) {
+    peso.set(key, new Set(g.filter((r) => Number.isFinite(r.value)).map((r) => r.Site)).size);
+  }
+
+  const out = new Map();
+  const grupos = ordem ?? uniq(agg.map((r) => r.group));
+  for (const g of grupos) {
+    const pts = agg
+      .filter((r) => r.group === g && Number.isFinite(r.mean))
+      .map((r) => ({ x: r.Year, y: r.mean, w: peso.get(`${r.Year}|${g}`) || 1 }))
+      .sort((a, b) => a.x - b.x);
+    const m = pts.length;
+    if (m < TREND_MIN_ANOS) { out.set(g, { anos: m, ajustou: false }); continue; }
+
+    // Pesos somando m: o tamanho efetivo da amostra passa a ser o nº de anos.
+    const somaW = pts.reduce((a, p) => a + p.w, 0);
+    const w = pts.map((p) => (p.w * m) / somaW);
+
+    const mx = pts.reduce((a, p, i) => a + w[i] * p.x, 0) / m;
+    const my = pts.reduce((a, p, i) => a + w[i] * p.y, 0) / m;
+    const sxx = pts.reduce((a, p, i) => a + w[i] * (p.x - mx) ** 2, 0);
+    if (!(sxx > 0)) { out.set(g, { anos: m, ajustou: false }); continue; }
+    const sxy = pts.reduce((a, p, i) => a + w[i] * (p.x - mx) * (p.y - my), 0);
+
+    const b = sxy / sxx;
+    const a0 = my - b * mx;
+    const sse = pts.reduce((a, p, i) => a + w[i] * (p.y - (a0 + b * p.x)) ** 2, 0);
+    const se = Math.sqrt((sse / (m - 2)) / sxx);
+    const t = se > 0 ? Math.abs(b / se) : 0;
+
+    out.set(g, {
+      ajustou: true, a: a0, b, se, anos: m, t,
+      x0: pts[0].x, x1: pts[m - 1].x,
+      span: pts[m - 1].x - pts[0].x,
+      // "Distinguivel de zero" ao nivel de 95%, com os graus de liberdade
+      // que esta serie de fato tem.
+      significativo: t > tCritico(m - 2),
+    });
+  }
+  return out;
+}
